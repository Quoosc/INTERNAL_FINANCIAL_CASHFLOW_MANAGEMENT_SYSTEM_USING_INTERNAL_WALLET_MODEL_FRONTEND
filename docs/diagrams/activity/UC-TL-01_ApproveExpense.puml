@startuml

title UC-TL-01: Duyệt Chi tiêu cá nhân (Flow 1 — Segregation of Duties)

|Team Leader|
start
:Xem DS yêu cầu PENDING
trong dự án mình là LEADER;

|He thong|
:GET /team-leader/approvals
?type=&projectId=&search=&page=0&size=20
(Status filter ngầm: PENDING);

|Co so du lieu|
:Truy vấn approvals theo project + PENDING;
:Trả về danh sách TLApprovalListItem;

|He thong|
:Hiển thị DS yêu cầu chờ duyệt;

|Team Leader|
:Chọn YC → Xem chi tiết + chứng từ;

if (Quyết định?) then (Duyệt)
  :Nhập approvedAmount + comment (optional);
  :Nhấn "Duyệt";

  |He thong|
  :POST /team-leader/approvals/{id}/approve
  { approvedAmount, comment? };

  |Co so du lieu|
  :request.status = APPROVED_BY_TEAM_LEADER;
  :Lưu approval history;

  |He thong|
  :Gửi notification cho Accountant
  (REQUEST_APPROVED_BY_TL);
  :Gửi notification cho Employee;

  |Team Leader|
  :Đã duyệt
  → Chờ Accountant giải ngân;
  stop
else (Từ chối)
  :Nhấn "Từ chối";
  :Nhập lý do từ chối (bắt buộc);

  |He thong|
  :POST /team-leader/approvals/{id}/reject
  { reason };

  |Co so du lieu|
  :request.status = REJECTED;
  :Lưu rejection reason;

  |He thong|
  :Gửi notification cho Employee
  (REQUEST_REJECTED);

  |Team Leader|
  :Đã từ chối;
  stop
endif

@enduml
