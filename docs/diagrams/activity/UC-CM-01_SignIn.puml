@startuml

title UC-CM-01: Quy trình Đăng nhập

|Nguoi dung|
start
:Truy cập trang Đăng nhập;
:Nhập Email và Password;
:Nhấn nút "Đăng nhập";

|He thong|
:Kiểm tra định dạng dữ liệu;
note right
  Email hợp lệ,
  Password không rỗng
end note

if (Dữ liệu hợp lệ?) then (Không)
  |Nguoi dung|
  :Hiển thị lỗi nhập liệu;
  stop
else (Có)
endif

|Co so du lieu|
:Kiểm tra Email trong DB;

if (Email tồn tại?) then (Không)
  |He thong|
  :Hiển thị "Email hoặc mật khẩu không đúng";
  |Nguoi dung|
  stop
else (Có)
endif

|Co so du lieu|
:Kiểm tra trạng thái tài khoản;

if (Tài khoản bị khóa?) then (Có)
  |He thong|
  :Hiển thị "Tài khoản bị khóa";
  |Nguoi dung|
  stop
else (Không)
endif

|He thong|
:Xác thực mật khẩu (BCrypt);

if (Mật khẩu đúng?) then (Không)
  :Hiển thị "Email hoặc mật khẩu không đúng";
  |Nguoi dung|
  stop
else (Có)
endif

|He thong|
:Backend trả về LoginResponse
{ requiresSetup, setupToken|null,
  accessToken|null, refreshToken|null, user };

if (requiresSetup = true?) then (Có — Lần đầu đăng nhập)
  |He thong|
  :Lưu setupToken vào sessionStorage;
  :Chuyển hướng → /change-password;

  |Nguoi dung|
  :Nhập newPassword + confirmPassword + PIN (5 số);

  |He thong|
  :POST /auth/first-login/complete
  { setupToken, newPassword, confirmPassword, pin };

  |Co so du lieu|
  :Tạo PIN + đổi mật khẩu mới;
  :Cấp accessToken + refreshToken;

  |He thong|
  :Lưu tokens vào localStorage + Cookie;
  :Ghi nhận audit (USER_CREATED_PIN);

  |Nguoi dung|
  :Chuyển hướng → Dashboard theo Role;
  stop
else (Không — Đăng nhập bình thường)
  |He thong|
  :Lưu accessToken + refreshToken vào localStorage;
  :Set cookie "access_token" (max-age 24h);
  :Lưu user_info vào localStorage;

  |Nguoi dung|
  :Chuyển hướng → Dashboard theo Role;
  stop
endif

@enduml
