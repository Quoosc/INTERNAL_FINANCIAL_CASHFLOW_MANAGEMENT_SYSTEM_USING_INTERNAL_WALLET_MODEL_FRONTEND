@startuml

title UC-ACC-01: Giải ngân (Flow 1 — Accountant Execution)

|Accountant|
start
:Chọn "Giải ngân";

|He thong|
:GET /accountant/disbursements
?type=&search=&page=0&size=20
(Chỉ thấy APPROVED_BY_TEAM_LEADER);

|Co so du lieu|
:Truy vấn disbursements
status = APPROVED_BY_TEAM_LEADER;

|He thong|
:Hiển thị DS yêu cầu đã TL duyệt;

|Accountant|
:Chọn YC → Kiểm tra chứng từ;

if (Quyết định?) then (Giải ngân)
  :Nhấn "Giải ngân";
  :Nhập PIN Accountant (5 số);

  |He thong|
  :POST /accountant/disbursements/{id}/disburse
  { pin, note? };
  :Xác thực PIN;

  if (PIN đúng?) then (Sai / Bị khóa)
    |Accountant|
    :Thông báo "Sai PIN" / "PIN bị khóa";
    stop
  else (Đúng)
  endif

  |Co so du lieu|
  :Kiểm tra Project Wallet.availableBalance >= amount;

  |He thong|
  if (Quỹ dự án đủ?) then (Không)
    |Accountant|
    :Thông báo "Quỹ dự án không đủ";
    stop
  else (Có)
  endif

  |Co so du lieu|
  :Project Wallet.debit(amount);
  :User Wallet.credit(amount);
  :createTransaction(REQUEST_PAYMENT);
  :request.status = PAID;

  |He thong|
  :Push SSE "wallet.updated" → Employee;
  :Push SSE "notification" (REQUEST_PAID) → Employee;

  |Accountant|
  :Giải ngân thành công;
  stop

else (Từ chối — Sai sót chứng từ)
  :Nhấn "Từ chối";
  :Nhập lý do;

  |He thong|
  :POST /accountant/disbursements/{id}/reject
  { reason };

  |Co so du lieu|
  :request.status = REJECTED;

  |He thong|
  :Push SSE "notification" (REQUEST_REJECTED) → Employee;

  |Accountant|
  :Đã từ chối;
  stop
endif

@enduml
