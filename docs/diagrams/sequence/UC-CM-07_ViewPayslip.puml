@startuml

actor "Nhân viên" as Emp
participant "Frontend\n(Next.js)" as FE
participant "PayslipController" as API
database "payslips / payroll_periods" as DB

== Xem danh sách phiếu lương ==

Emp -> FE: Chọn "Phiếu lương"
FE -> API: GET /api/v1/payslips\n?year=&status=DRAFT|PAID&page=1&limit=12
API -> DB: findPayslipsByUserId(currentUser.id, filters)
DB --> API: { items: PayslipListItem[], total, page, limit, totalPages }
API --> FE: 200 PaginatedResponse<PayslipListItem>
FE --> Emp: Danh sách kỳ lương\n(theo năm, lọc theo trạng thái)

note right of FE
  PayslipStatus: DRAFT | PAID
  page là 1-indexed
end note

== Xem chi tiết phiếu lương ==

Emp -> FE: Chọn 1 phiếu lương
FE -> API: GET /api/v1/payslips/{id}
API -> DB: findPayslipById(id, userId)
DB --> API: PayslipDetailResponse
API --> FE: 200 PayslipDetailResponse
FE --> Emp: Chi tiết phiếu lương:\n- baseSalary (lương cơ bản)\n- bonus (thưởng)\n- deduction (khấu trừ)\n- advanceDeduct (khấu trừ tạm ứng)\n- netSalary (lương thực nhận)\n- status (DRAFT | PAID)

note right of FE
  advanceDeduct = min(debtBalance, 50% * netSalary)
  Tự động tính khi Accountant chạy auto-netting
  trước khi run payroll
end note

@enduml
