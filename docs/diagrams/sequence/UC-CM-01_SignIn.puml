@startuml

actor "Người dùng" as User
participant "Frontend\n(Next.js)" as FE
participant "AuthController" as AuthCtrl
database "users" as DB

User -> FE: Nhập email + password
FE -> AuthCtrl: POST /api/v1/auth/login\n{ email, password }
AuthCtrl -> DB: findByEmail(email)

alt Email không tồn tại
    DB --> AuthCtrl: null
    AuthCtrl --> FE: 401 "Invalid credentials"
    FE --> User: Hiển thị lỗi đăng nhập
else Tài khoản LOCKED
    DB --> AuthCtrl: user (status = LOCKED)
    AuthCtrl --> FE: 403 "Account is locked"
    FE --> User: Hiển thị tài khoản bị khóa
else Email tồn tại & ACTIVE
    DB --> AuthCtrl: user
    AuthCtrl -> AuthCtrl: BCrypt.matches(password, user.password)
    alt Sai password
        AuthCtrl --> FE: 401 "Invalid credentials"
        FE --> User: Hiển thị lỗi đăng nhập
    else Đúng password
        AuthCtrl --> FE: 200 LoginResponse\n{ requiresSetup, setupToken|null,\n  accessToken|null, refreshToken|null, user }

        alt requiresSetup = true (Đăng nhập lần đầu)
            FE -> FE: sessionStorage["setup_token"] = setupToken
            FE --> User: Redirect → /change-password
            note right of FE
              Trang /change-password yêu cầu:
              1. Đổi mật khẩu mới
              2. Tạo PIN 5 số
              (gộp 1 bước, 1 form)
            end note
            User -> FE: Nhập newPassword + confirmPassword + pin
            FE -> AuthCtrl: POST /api/v1/auth/first-login/complete\n{ setupToken, newPassword, confirmPassword, pin }
            AuthCtrl --> FE: 200 LoginResponse\n{ accessToken, refreshToken, user }
            FE -> FE: localStorage["access_token"] = accessToken\nlocalStorage["refresh_token"] = refreshToken\nlocalStorage["user_info"] = JSON.stringify(user)\nsetCookie("access_token", accessToken, 24h)
            FE --> User: Redirect → /dashboard
        else requiresSetup = false (Đăng nhập bình thường)
            FE -> FE: localStorage["access_token"] = accessToken\nlocalStorage["refresh_token"] = refreshToken\nlocalStorage["user_info"] = JSON.stringify(user)\nsetCookie("access_token", accessToken, 24h)
            FE --> User: Redirect → /dashboard (theo role)
        end
    end
end

== Token Hết hạn (Auto Refresh) ==

FE -> AuthCtrl: [Bất kỳ request] → 401 Unauthorized
FE -> AuthCtrl: POST /api/v1/auth/refresh-token\n{ refreshToken }
alt Refresh thành công
    AuthCtrl --> FE: 200 { accessToken, refreshToken }
    FE -> FE: setTokens() + setCookie()
    FE -> AuthCtrl: Retry request gốc
else Refresh thất bại
    AuthCtrl --> FE: 401
    FE -> FE: clearTokens() + clearCookie()
    FE --> User: Redirect → /login
end

@enduml
