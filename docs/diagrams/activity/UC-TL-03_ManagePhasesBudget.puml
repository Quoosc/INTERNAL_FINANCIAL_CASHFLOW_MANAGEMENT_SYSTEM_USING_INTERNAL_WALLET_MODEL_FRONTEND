@startuml

title UC-TL-03: Quản lý Phase & Ngân sách Dự án

|Team Leader|
start
:Chọn DA → "Quản lý Phase";

|He thong|
:GET /team-leader/projects/{id};

|Co so du lieu|
:Truy vấn TLProjectDetailResponse + phases;

|He thong|
:Hiển thị DS Phase (ACTIVE / CLOSED);

|Team Leader|
if (Thao tác?) then (Tạo Phase mới)
  :Nhập name, budgetLimit, startDate, endDate;

  |He thong|
  :POST /team-leader/projects/{id}/phases
  { name, budgetLimit, startDate, endDate };

  |Co so du lieu|
  :save(ProjectPhase, status = ACTIVE);

  |Team Leader|
  :Tạo Phase thành công;
  stop

elseif (Thao tác = Cập nhật Phase?) then (Có)
  :Chọn Phase → Sửa name / budgetLimit / endDate / status;

  |He thong|
  :PUT /team-leader/projects/{id}/phases/{phaseId}
  { name?, budgetLimit?, endDate?, status? };

  |Co so du lieu|
  :Cập nhật ProjectPhase;

  |Team Leader|
  :Cập nhật thành công;
  stop

else (Quản lý Category Budget)
  :Chọn Phase → Xem danh sách Category;

  |He thong|
  :GET /team-leader/projects/{id}/categories?phaseId={phaseId};

  |Co so du lieu|
  :Trả về danh sách ExpenseCategory + budgetLimit;

  |Team Leader|
  :Đặt/Sửa budgetLimit cho một Category;

  |He thong|
  :PUT /team-leader/projects/{id}/categories
  { phaseId, categoryId, budgetLimit };

  |Co so du lieu|
  :Cập nhật CategoryBudget;

  |Team Leader|
  :Cập nhật ngân sách Category thành công;
  stop
endif

@enduml
