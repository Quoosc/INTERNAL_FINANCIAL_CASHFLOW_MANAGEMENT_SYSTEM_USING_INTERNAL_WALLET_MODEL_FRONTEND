@startuml

actor "CFO" as CFO
participant "Frontend\n(Next.js)" as FE
participant "AdminSettingsController" as API
database "system_configs" as DB

CFO -> FE: Chọn "Cấu hình hệ thống"
FE -> API: GET /api/v1/admin/settings
API -> DB: findAll(SystemConfig)
DB --> API: SystemSettingsResponse\n{ items: [{key, value, description}] }
API --> FE: 200 SystemSettingsResponse
FE --> CFO: Danh sách config (key, value, description)

CFO -> FE: Chỉnh sửa values → Nhấn "Lưu"
FE -> API: PUT /api/v1/admin/settings\n{ configs: [{key, value}, ...] }
note right of FE
  Config keys:
  WITHDRAWAL_LIMIT, MINIMUM_WITHDRAWAL,
  MAX_FILE_SIZE_MB, MAX_FILES_PER_REQUEST,
  MINIMUM_REQUEST_AMOUNT,
  PIN_MAX_RETRY, PIN_LOCK_DURATION_MINUTES,
  REQUIRE_PIN_FOR_WITHDRAWAL
end note
API -> DB: Cập nhật các config được gửi lên
API -> API: auditEvent(CONFIG_UPDATED)
API --> FE: 200 SystemSettingsResponse (updated)
FE --> CFO: Cập nhật cấu hình thành công

@enduml
