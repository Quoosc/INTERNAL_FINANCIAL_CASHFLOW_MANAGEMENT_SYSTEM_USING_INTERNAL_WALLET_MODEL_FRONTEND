@startuml

title UC-MGR-02: Duyệt cấp vốn Dự án (Flow 2)

|Manager|
start
:Xem DS YC PROJECT_TOPUP chờ duyệt;

|He thong|
:GET /manager/approvals?search=&page=0&size=20
(Status filter ngầm: PENDING);

|Co so du lieu|
:Truy vấn PROJECT_TOPUP thuộc department của Manager;

|He thong|
:Hiển thị DS yêu cầu cấp vốn;

|Manager|
:Chọn YC → Xem chi tiết:
DA, số tiền, quỹ PB còn lại;

if (Quyết định?) then (Duyệt)
  :Nhập approvedAmount + comment (optional);
  :Nhấn "Duyệt";

  |He thong|
  :POST /manager/approvals/{id}/approve
  { approvedAmount, comment? };

  |Co so du lieu|
  :request.status = APPROVED_BY_MANAGER;

  |He thong|
  :Gửi notification cho Team Leader
  (PROJECT_TOPUP_APPROVED);
  note right
    Scheduler tự động xử lý ~1 phút sau:
    Department Wallet → Project Wallet
    (PROJECT_QUOTA_ALLOCATION)
    request.status = PAID
    Không cần Accountant
  end note

  |Manager|
  :Đã duyệt — Scheduler tự giải ngân;
  stop
else (Từ chối)
  :Nhấn "Từ chối";
  :Nhập lý do (bắt buộc);

  |He thong|
  :POST /manager/approvals/{id}/reject
  { reason };

  |Co so du lieu|
  :request.status = REJECTED;

  |He thong|
  :Gửi notification cho Team Leader
  (PROJECT_TOPUP_REJECTED);

  |Manager|
  :Đã từ chối;
  stop
endif

@enduml
