@startuml

title UC-CM-05: Nạp tiền vào Ví (VNPay)

|Nguoi dung|
start
:Nhấn "Nạp tiền";
:Nhập số tiền (tối thiểu 10.000 VND);
note right
  Không cần nhập PIN để nạp tiền
  PIN chỉ cần cho rút tiền / giải ngân
end note

|He thong|
if (Số tiền hợp lệ?) then (Không)
  |Nguoi dung|
  :Thông báo "Số tiền không hợp lệ";
  stop
else (Có)
endif

|He thong|
:POST /wallet/deposit
{ amount, bankCode?, locale? };
:Backend tự sinh depositCode = "DEP-YYYYMMDD-XXXX";

|Co so du lieu|
:Tạo DepositLog (status = PENDING);

|He thong|
:Tạo paymentUrl với VNPay;
:Trả về DepositLogResponse { paymentUrl };

|Nguoi dung|
:Mở trang thanh toán VNPay;
:Thực hiện thanh toán
(QR / ATM / Internet Banking);

|He thong|
:VNPay gọi IPN callback server-to-server
(FE không tham gia bước này);

if (Thanh toán thành công?) then (Có)
  |Co so du lieu|
  :depositLog.status = COMPLETED;
  :Company Fund Wallet.credit(amount);
  :Tạo LedgerEntry (CREDIT, DEPOSIT);

  |He thong|
  :Push SSE event "wallet.updated"
  → WalletContext.updateFromSse();
  :Push SSE event "transaction.created";

  |Nguoi dung|
  :Số dư ví tự động cập nhật;
  :Trang VNPay redirect về /wallet/deposit/my;
  stop
else (Không — Hết hạn / Lỗi)
  |Co so du lieu|
  :depositLog.status = FAILED;

  |Nguoi dung|
  :Trang VNPay hiển thị thất bại;
  :Kiểm tra lịch sử tại /wallet/deposit/my;
  stop
endif

@enduml
