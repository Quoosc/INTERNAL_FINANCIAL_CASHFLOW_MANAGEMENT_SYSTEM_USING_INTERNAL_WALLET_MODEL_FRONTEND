@startuml

title UC-EMP-01: Quản lý Yêu cầu Chi tiêu cá nhân (Flow 1)

|Employee|
start
:Nhấn "Tạo yêu cầu mới";
:Chọn loại: ADVANCE | EXPENSE | REIMBURSE;

|He thong|
:GET /projects?status=ACTIVE
→ Danh sách dự án đang hoạt động;

|Employee|
:Chọn Dự án → Chọn Phase → Chọn Category;
:Nhập số tiền + mô tả;

if (Loại EXPENSE hoặc REIMBURSE?) then (Có — bắt buộc chứng từ)
  |He thong|
  :GET /uploads/signature?folder=REQUEST
  → Lấy Cloudinary signature;

  |Employee|
  :Chọn file đính kèm;

  |He thong|
  :Upload file trực tiếp lên Cloudinary;
  :Nhận { url, publicId, fileType, size };
else (ADVANCE — không bắt buộc)
endif

if (Loại REIMBURSE?) then (Có — cần tạm ứng cũ)
  |Employee|
  :Chọn advanceBalance cần hoàn quyết
  (advanceBalanceId bắt buộc);
else (Không)
endif

|Employee|
:Nhấn "Gửi yêu cầu";

|He thong|
:POST /requests
{ type, projectId, phaseId, categoryId,
  amount, description, attachments[],
  advanceBalanceId? };

|Co so du lieu|
:save(Request, status = PENDING,
  requestCode tự sinh);
:Gửi notification cho Team Leader;

|He thong|
:Trả về 201 RequestDetailResponse;

|Employee|
:Yêu cầu đã gửi (PENDING)
→ Chờ Team Leader duyệt;

if (Muốn hủy khi status = PENDING?) then (Có)
  :Nhấn "Hủy";

  |He thong|
  :DELETE /requests/{id};

  |Co so du lieu|
  :request.status = CANCELLED;

  |Employee|
  :Yêu cầu đã hủy (CANCELLED);
  stop
else (Không — theo dõi tiến trình)
  stop
endif

@enduml
