@startuml

title UC-CFO-04: Xem Nhật ký Hệ thống (CFO)

|CFO|
start
:Chọn "Nhật ký hệ thống" trên menu;

|He thong|
:GET /admin/audit?actorId=&action=&entityName=&from=&to=&page=1&limit=50;
note right
  Endpoint dùng chung với Admin: /admin/audit
  page là 1-indexed
  Bộ lọc: actorId, action, entityName, from, to
end note

|Co so du lieu|
:Truy vấn PaginatedResponse AuditLogResponse (sort createdAt DESC);

|He thong|
:Hiển thị DS audit log (actorName, action, entityName, createdAt);

|CFO|
if (Áp dụng bộ lọc?) then (Theo Action)
  :Chọn AuditAction từ dropdown;

  |He thong|
  :GET /admin/audit?action={action}&page=1&limit=50;

  |CFO|
  :Xem DS lọc theo action;
  stop

elseif (Lọc theo diễn viên?) then (Có)
  :Nhập actorId (userId của người thực hiện);

  |He thong|
  :GET /admin/audit?actorId={actorId}&page=1&limit=50;

  |CFO|
  :Xem lịch sử hành động của 1 người;
  stop

else (Theo khoảng thời gian)
  :Chọn from → to (ngày);

  |He thong|
  :GET /admin/audit?from={from}&to={to}&page=1&limit=50;

  |CFO|
  :Xem audit trong khoảng thời gian;
  stop
endif

@enduml
