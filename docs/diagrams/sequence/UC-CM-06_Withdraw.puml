@startuml

actor "Người dùng" as User
participant "Frontend\n(Next.js)" as FE
participant "WalletController" as API
database "wallets / withdraw_requests" as DB

== Tạo yêu cầu rút tiền ==

User -> FE: Nhấn "Rút tiền"\nNhập số tiền + ghi chú
note right of FE
  Thông tin ngân hàng thụ hưởng đã lưu
  trong hồ sơ người dùng (PUT /users/me/bank-info)
  Không nhập lại số TK NH trong form rút tiền
end note
FE --> User: Hiển thị popup nhập PIN
User -> FE: Nhập PIN (5 số)
FE -> API: POST /api/v1/wallet/withdraw\n{ amount, userNote, pin }
API -> API: Xác thực PIN
alt Sai PIN
    API --> FE: 401 "Invalid PIN"
    FE --> User: Sai PIN
else PIN bị khóa (sai > 5 lần)
    API --> FE: 423 "PIN locked"
    FE --> User: PIN bị khóa
else PIN đúng
    API -> DB: Kiểm tra availableBalance >= amount
    alt Số dư không đủ
        API --> FE: 400 "Insufficient balance"
        FE --> User: Số dư không đủ
    else Đủ số dư
        API -> DB: wallet.lockedBalance += amount
        API -> DB: save(WithdrawRequest, status=PENDING,\n  withdrawCode = "WD-YYYY-XXXXXX")
        API --> FE: 200 WithdrawRequestResponse\n{ id, withdrawCode, amount, userNote,\n  status: PENDING, ... }
        FE --> User: Yêu cầu rút tiền đã gửi\n(Chờ xử lý)
    end
end

== Hủy yêu cầu rút tiền (khi PENDING) ==

User -> FE: Nhấn "Hủy" trên yêu cầu đang PENDING
FE -> API: DELETE /api/v1/wallet/withdraw/{id}
API -> DB: Kiểm tra status = PENDING
alt Không phải PENDING
    API --> FE: 400 "Cannot cancel"
    FE --> User: Không thể hủy
else PENDING
    API -> DB: withdrawRequest.status = CANCELLED\nwallet.lockedBalance -= amount
    API --> FE: 200 WithdrawRequestResponse { status: CANCELLED }
    FE --> User: Đã hủy yêu cầu rút tiền
end

== Xem lịch sử rút tiền ==

User -> FE: Chọn "Lịch sử rút tiền"
FE -> API: GET /api/v1/wallet/withdraw/my?page=0&size=10
API --> FE: PageResponse<WithdrawRequestResponse>
FE --> User: Danh sách yêu cầu rút tiền\n(PENDING / COMPLETED / FAILED / REJECTED / CANCELLED)

@enduml
