@startuml

actor "Accountant / CFO" as Acc
participant "Frontend\n(Next.js)" as FE
participant "CompanyFundController" as API
database "company_fund / wallets" as DB

== Xem trạng thái quỹ công ty ==

Acc -> FE: Chọn "Quỹ hệ thống"
FE -> API: GET /api/v1/company-fund
API -> DB: findCompanyFund() + Wallet(COMPANY_FUND, ownerId=1)
DB --> API: CompanyFundResponse\n{ balance từ Wallet(COMPANY_FUND),\n  bankName, bankAccount, ... }
API --> FE: 200 CompanyFundResponse
FE --> Acc: Hiển thị số dư quỹ công ty\n(balance, lockedBalance, availableBalance)

note right of DB
  Balance thực tế lưu trong Wallet(COMPANY_FUND, ownerId=1)
  CompanyFund entity chỉ lưu metadata ngân hàng
  Invariant: FLOAT_MAIN.balance = SUM(tất cả wallet khác)
end note

== Nạp tiền vào quỹ (từ ngân hàng thực tế) ==

Acc -> FE: Nhấn "Nạp vốn từ ngân hàng"\nNhập: amount, paymentRef, description
FE -> API: POST /api/v1/company-fund/topup\n{ amount, paymentRef, description }
API -> DB: Company Fund Wallet.credit(amount)
API -> DB: FLOAT_MAIN.credit(amount)
API -> DB: createTransaction(SYSTEM_TOPUP)
API -> API: auditEvent(SYSTEM_FUND_ADJUSTED)
API --> FE: 200 TransactionResponse
FE --> Acc: Nạp quỹ thành công\n(Company Fund + amount)

note right of API
  SYSTEM_TOPUP là boundary transaction:
  External Bank → Company Fund Wallet
  1 LedgerEntry duy nhất (không có source wallet trong hệ thống)
  FLOAT_MAIN.balance tăng theo
end note

== Cập nhật thông tin ngân hàng ngoài ==

opt Cập nhật số dư NH thực tế
    Acc -> FE: Nhập số dư ngân hàng thực tế
    FE -> API: PUT /api/v1/company-fund/bank-statement\n{ externalBalance, statementDate }
    API -> DB: Cập nhật CompanyFund metadata
    API --> FE: 200 CompanyFundResponse
    FE --> Acc: Cập nhật thành công
end

== Kiểm tra đối chiếu (Reconciliation) ==

opt Kiểm tra tính nhất quán quỹ
    Acc -> FE: Nhấn "Đối chiếu quỹ"
    FE -> API: GET /api/v1/company-fund/reconciliation
    API -> DB: Tính FLOAT_MAIN.balance vs SUM(all wallets)
    API --> FE: 200 ReconciliationReportResponse
    FE --> Acc: Báo cáo đối chiếu\n(discrepancy = 0 → OK,\n discrepancy ≠ 0 → có sai sót)
end

@enduml
