@startuml

actor "Team Leader" as TL
participant "Frontend\n(Next.js)" as FE
participant "TLProjectController" as API
database "project_phases / categories" as DB

TL -> FE: Chọn DA → "Quản lý Phase"
FE -> API: GET /api/v1/team-leader/projects/{id}
API --> FE: TLProjectDetailResponse + phases

== Tạo Phase mới ==

TL -> FE: Nhấn "Thêm Phase"\nNhập name, budgetLimit, startDate, endDate
FE -> API: POST /api/v1/team-leader/projects/{id}/phases\n{ name, budgetLimit, startDate, endDate }
API -> DB: save(ProjectPhase, status=ACTIVE)
API --> FE: 201 ProjectPhaseResponse
FE --> TL: Phase đã tạo

== Cập nhật Phase ==

TL -> FE: Chọn Phase → Sửa thông tin
FE -> API: PUT /api/v1/team-leader/projects/{id}/phases/{phaseId}\n{ name?, budgetLimit?, endDate?, status? }
API -> DB: update(ProjectPhase)
API --> FE: 200 ProjectPhaseResponse

== Quản lý Category Budget ==

TL -> FE: Chọn Phase → Xem danh sách category
FE -> API: GET /api/v1/team-leader/projects/{id}/categories?phaseId={phaseId}
API --> FE: PhaseCategoriesResponse\n{ items: [{id, name, budgetLimit}] }

TL -> FE: Đặt budget cho 1 category
FE -> API: PUT /api/v1/team-leader/projects/{id}/categories\n{ phaseId, categoryId, budgetLimit }
API -> DB: update(CategoryBudget)
API --> FE: 200 CategoryBudgetResponse

opt Xem danh sách expense categories của project
    FE -> API: GET /api/v1/team-leader/expense-categories?projectId={projectId}
    API --> FE: List<ExpenseCategoryResponse>
end

@enduml
