@startuml

title UC-CM-02: Quản lý Hồ sơ cá nhân

|Nguoi dung|
start
:Chọn "Hồ sơ cá nhân" trên menu;

|He thong|
:GET /users/me/profile;

|Co so du lieu|
:Truy vấn UserProfile theo userId;
:Trả về UserProfileResponse;

|He thong|
:Hiển thị thông tin: Tên, SĐT,
Địa chỉ, Ảnh đại diện, TT Ngân hàng;

|Nguoi dung|
if (Chỉnh sửa thông tin gì?) then (Hồ sơ cá nhân)
  :Sửa fullName, phone, address, ...;
  :Nhấn "Lưu";

  |He thong|
  :PUT /users/me/profile;

  |Co so du lieu|
  :Lưu UserProfile vào DB;

  |He thong|
  :Trả về UserProfileResponse;
  |Nguoi dung|
  :Thông báo cập nhật thành công;

elseif (Chỉnh sửa?) then (Ảnh đại diện)
  :Chọn ảnh mới;

  |He thong|
  :GET /uploads/signature?folder=AVATAR → Lấy signature;
  :Upload ảnh lên Cloudinary (signed URL);
  :PUT /users/me/avatar { avatar: cloudinaryUrl };
  note right
    Avatar là Signed URL Cloudinary
    Hết hạn sau 15 phút — cần refresh khi hiển thị
  end note

  |Nguoi dung|
  :Ảnh đại diện đã cập nhật;

else (Thông tin ngân hàng)
  :Nhập thông tin TK ngân hàng;

  |He thong|
  :PUT /users/me/bank-info { ...UpdateBankInfoRequest };
  note right
    Cập nhật bank info dùng endpoint riêng
    Backend ghi Audit Log: BANK_INFO_UPDATED
  end note

  |Co so du lieu|
  :Lưu BankInfo vào DB;
  :Ghi Audit Log BANK_INFO_UPDATED;

  |He thong|
  :Trả về BankInfo;
  |Nguoi dung|
  :Thông báo cập nhật thành công;
endif

stop

@enduml
