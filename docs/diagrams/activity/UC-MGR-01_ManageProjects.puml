@startuml

title UC-MGR-01: Quản lý Dự án (Manager)

|Manager|
start

if (Thao tác = Tạo DA mới?) then (Có)
  :Nhập: name, description, totalBudget;
  :Chọn Team Leader từ danh sách phòng ban;

  |He thong|
  :GET /manager/department/team-leaders
  → Danh sách TL trong phòng ban;

  |Manager|
  :Xác nhận tạo DA;

  |He thong|
  :POST /manager/projects
  { name, description?, totalBudget, teamLeaderId };

  |Co so du lieu|
  :save(Project, dept = manager.dept, status = PLANNING);
  :save(ProjectMember, role = LEADER, userId = teamLeaderId);

  |Manager|
  :Tạo DA thành công;
  stop

elseif (Thao tác = Cập nhật?) then (Có)
  :Chọn DA → Sửa name / description / totalBudget / teamLeaderId / status;

  |He thong|
  :PUT /manager/projects/{id}
  { name?, description?, totalBudget?, status?, teamLeaderId? };

  |Co so du lieu|
  :Cập nhật Project;

  |Manager|
  :Cập nhật thành công;
  stop

else (Đổi trạng thái)
  if (Action?) then (Tạm dừng)
    |He thong|
    :PUT /manager/projects/{id} { status: "PAUSED" };

    |Co so du lieu|
    :project.status = PAUSED
    → Chặn tạo request mới trong DA;

    |Manager|
    stop
  else (Đóng DA)
    |He thong|
    :PUT /manager/projects/{id} { status: "CLOSED" };

    |Co so du lieu|
    :project.status = CLOSED;

    |Manager|
    stop
  endif
endif

@enduml
