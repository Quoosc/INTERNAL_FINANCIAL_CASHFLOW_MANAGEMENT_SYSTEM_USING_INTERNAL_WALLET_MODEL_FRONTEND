@startuml

title UC-CM-03: Quản lý PIN Giao dịch

|Nguoi dung|
start
:Chọn "Đổi PIN giao dịch" trong phần Bảo mật;
:Nhập PIN hiện tại (currentPin) + PIN mới (newPin, 5 số);

note right
  Đổi PIN dùng currentPin (không phải mật khẩu)
  PUT /users/me/pin { currentPin, newPin }
end note

|He thong|
:Xác thực currentPin (BCrypt so sánh với DB);

if (PIN hiện tại đúng?) then (Sai)
  :retryCount++;

  if (retryCount > 5?) then (Có — Bị khóa)
    |Co so du lieu|
    :Cập nhật lockedUntil (30 phút);

    |He thong|
    :Ghi Audit Log PIN_LOCKED;
    |Nguoi dung|
    :Thông báo "PIN bị khóa 30 phút";
    stop
  else (Chưa — Thử lại)
    |Nguoi dung|
    :Thông báo "Sai PIN — Còn N lần thử";
    stop
  endif
else (Đúng)
endif

|He thong|
:Validate PIN mới (5 chữ số);

if (PIN mới hợp lệ?) then (Không)
  |Nguoi dung|
  :Thông báo "PIN phải đúng 5 chữ số";
  stop
else (Có)
endif

|He thong|
:BCrypt.encode(newPin);

|Co so du lieu|
:Lưu PIN mã hóa vào user_security_settings;

|He thong|
:Ghi Audit Log PIN_RESET;
:Thông báo thành công;

|Nguoi dung|
:Cập nhật PIN thành công;
stop

@enduml
