@startuml

title UC-ACC-02: Quản lý Bảng lương (Payroll)

|Accountant|
start

note right
  Thứ tự BẮT BUỘC:
  1. Tạo kỳ lương
  2. Import Excel
  3. Auto-netting
  4. Run (chi lương)
end note

:Bước 1: Tạo kỳ lương mới;
:Nhập name, month, year, startDate, endDate;

|He thong|
:POST /accountant/payroll
{ name, month, year, startDate, endDate };

|Co so du lieu|
:save(PayrollPeriod, status = DRAFT);

|Accountant|
:Bước 2: Upload Excel bảng lương;

|He thong|
:POST /accountant/payroll/{periodId}/import
(multipart/form-data, field: "file");
:Parse Excel → Validate từng dòng;

if (Dữ liệu trùng lặp?) then (Có)
  |Accountant|
  :Nhấn "Xác nhận ghi đè";

  |He thong|
  :POST /accountant/payroll/{periodId}/confirm-overwrite;
else (Không)
endif

if (Dữ liệu hợp lệ?) then (Không)
  |Accountant|
  :Hiển thị lỗi validation;
  :Sửa file Excel và import lại;
  stop
else (Có)
endif

|Accountant|
:Preview bảng lương (baseSalary, bonus, deduction);

:Bước 3: Tính khấu trừ tạm ứng (Auto-Netting);

|He thong|
:POST /accountant/payroll/{periodId}/auto-netting;

|Co so du lieu|
while (Còn NV có debtBalance > 0?) is (Có)
  :advanceDeduct = min(debtBalance, 50% * netSalary);
  :Cập nhật payslip.advanceDeduct;
endwhile (Không)

|He thong|
:Trả về AutoNettingResponse { summary[] };

|Accountant|
:Preview sau khấu trừ tạm ứng;
:Bước 4: Chi lương chính thức;
:Nhấn "Chốt & Chi lương";

|He thong|
:POST /accountant/payroll/{periodId}/run;

|Co so du lieu|
:Kiểm tra Company Fund Wallet.balance >= totalNetSalary;

|He thong|
if (Quỹ công ty đủ?) then (Không)
  |Accountant|
  :Thông báo "Quỹ công ty không đủ";
  stop
else (Có)
endif

|He thong|
while (Còn Payslip chưa xử lý?) is (Có)
  |Co so du lieu|
  :Company Fund Wallet.debit(netSalary);
  :User Wallet.credit(netSalary);
  :createTransaction(PAYSLIP_PAYMENT);
  :payslip.status = PAID;

  |He thong|
  :Push SSE "wallet.updated" → Employee;
  :Push SSE "notification" (SALARY_PAID) → Employee;
endwhile (Không)

|Co so du lieu|
:PayrollPeriod.status = COMPLETED;

|Accountant|
:Chi lương thành công (COMPLETED);
stop

@enduml
