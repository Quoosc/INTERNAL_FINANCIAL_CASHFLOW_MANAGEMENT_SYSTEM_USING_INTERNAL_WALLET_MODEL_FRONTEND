@startuml

title UC-ACC-03: Quản lý Quỹ Công ty (Company Fund)

|Accountant|
start
:Chọn "Quỹ hệ thống";

|He thong|
:GET /company-fund;
note right
  Endpoint đổi từ /system-fund → /company-fund
  Balance thực tế trong Wallet(COMPANY_FUND, ownerId=1)
  CompanyFund entity chỉ lưu metadata ngân hàng
end note

|Co so du lieu|
:Truy vấn CompanyFund + Wallet(COMPANY_FUND);

|He thong|
:Hiển thị: Số dư quỹ
(balance, lockedBalance, availableBalance),
Thông tin ngân hàng;

|Accountant|
:Nhấn "Nạp vốn từ ngân hàng thực tế";
:Nhập số tiền, mã tham chiếu (paymentRef), mô tả;

|He thong|
:POST /company-fund/topup
{ amount, paymentRef, description };

|Co so du lieu|
:Company Fund Wallet.credit(amount);
:FLOAT_MAIN.credit(amount);
:createTransaction(SYSTEM_TOPUP, 1 LedgerEntry);

|He thong|
:Ghi Audit Log (SYSTEM_FUND_ADJUSTED);

|Accountant|
:Nạp vốn thành công;

if (Cần đối chiếu quỹ?) then (Có)
  |He thong|
  :GET /company-fund/reconciliation;

  |Co so du lieu|
  :Tính FLOAT_MAIN.balance vs SUM(all wallets);

  |He thong|
  if (Discrepancy = 0?) then (Có — OK)
    |Accountant|
    :Quỹ cân đối — Bình thường;
    stop
  else (Không — Có sai sót)
    :Cảnh báo discrepancy ≠ 0;
    :Cần điều tra giao dịch bất thường;
    stop
  endif
else (Không)
  stop
endif

@enduml
